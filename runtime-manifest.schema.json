{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xufeifei083-maker/zimao-runtime/main/runtime-manifest.schema.json",
  "title": "Zimao Windows NVIDIA Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtimeId",
    "pythonVersion",
    "comfyuiCommit",
    "pytorchVersion",
    "cudaVersion",
    "ffmpegVersion",
    "minimumDriver",
    "archiveSize",
    "archiveSha256",
    "requiredFiles",
    "parts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeId": { "type": "string", "pattern": "^win-nvidia-[A-Za-z0-9._-]+$" },
    "pythonVersion": { "type": "string", "pattern": "^3\\.12\\.[0-9]+$" },
    "comfyuiCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pytorchVersion": { "type": "string", "minLength": 1 },
    "cudaVersion": { "type": "string", "minLength": 1 },
    "ffmpegVersion": { "type": "string", "minLength": 1 },
    "minimumDriver": { "type": "string", "minLength": 1 },
    "archiveSize": { "type": "integer", "minimum": 1 },
    "archiveSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requiredFiles": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "size", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^runtime-.+\\.part[0-9]{2}$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
